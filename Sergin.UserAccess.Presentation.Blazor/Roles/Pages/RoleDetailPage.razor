@page "/ua/roles/{Id:guid}"

<PageTitle>Role</PageTitle>

<SerginBreadcrumbs Trail="Trail" />

<SerginProblemPanel Problem="problem" />

@if (role is not null)
{
    <MudCard Class="mb-4">
        <MudCardContent>
            <MudText Typo="Typo.h5">@role.Name</MudText>
            <MudText Typo="Typo.body2">Owned by <MudLink Href="@($"/ua/scopes/{role.OwnerScopeId}")">@role.OwnerScopeName</MudLink></MudText>
            <MudSwitch T="bool" Value="role.IsInheritable" ValueChanged="SetInheritableAsync" Color="Color.Primary"
                       Disabled="busy" Label="Inheritable: scopes below the owner can use it too" />
        </MudCardContent>
    </MudCard>

    <MudForm @ref="form" Model="model" Validation="@validation" @bind-IsValid="isValid"
             SuppressImplicitSubmission="false" onsubmit="@OnRename">
        <MudCard Class="mb-4">
            <MudCardContent>
                <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="model.Name" Label="Code" For="@(() => model.Name)" Immediate="true" />
            </MudCardContent>
            <MudCardActions>
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled"
                           Color="Color.Primary" Disabled="@(busy || !isValid)">Rename</MudButton>
            </MudCardActions>
        </MudCard>
    </MudForm>

    <MudCard Class="mb-4">
        <MudCardContent>
            <MudText Typo="Typo.h6">Permissions</MudText>
            @foreach (PermissionDefinition definition in GrantedDefined)
            {
                <MudChip T="string" Value="@definition.Permission.Value" OnClose="@(_ => RevokeAsync(definition.Permission.Value))">@Localizer[definition.Label].Value</MudChip>
            }
            @if (GrantedUnknown.Count > 0)
            {
                <MudText Typo="Typo.subtitle2">Unknown</MudText>
                @foreach (string permission in GrantedUnknown)
                {
                    <MudChip T="string" Value="@permission" OnClose="@(_ => RevokeAsync(permission))">@permission</MudChip>
                }
            }
            <MudSelect Variant="Variant.Outlined" Margin="Margin.Dense" T="string" @bind-Value="permissionToGrant" ToStringFunc="@LabelOf" Label="Add permission">
                @foreach (PermissionCatalogModule module in Catalog.Grouped())
                {
                    <PermissionSubheader>@PermissionLabels.Module(Localizer, module.Schema)</PermissionSubheader>
                    @foreach (PermissionCatalogGroup group in module.Groups)
                    {
                        <PermissionSubheader Class="pl-6">@group.Name</PermissionSubheader>
                        @foreach (PermissionDefinition definition in group.Permissions.Where(definition => !IsGranted(definition)))
                        {
                            <MudSelectItem T="string" Value="@definition.Permission.Value">
                                @Localizer[definition.Label].Value <MudText Typo="Typo.caption">@definition.Permission.Value</MudText>
                            </MudSelectItem>
                        }
                    }
                }
            </MudSelect>
        </MudCardContent>
        <MudCardActions>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                       Disabled="@(busy || string.IsNullOrEmpty(permissionToGrant))" OnClick="GrantAsync">Add</MudButton>
        </MudCardActions>
    </MudCard>

    <MudCard>
        <MudCardContent>
            <MudCheckBox T="bool" @bind-Value="cascade" Label="Also revoke every assignment of this role" />
        </MudCardContent>
        <MudCardActions>
            <MudButton Variant="Variant.Outlined" Color="Color.Error" Disabled="busy" OnClick="DeleteAsync">Delete</MudButton>
        </MudCardActions>
    </MudCard>
}
